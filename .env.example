# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Koin

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/koin
# SQLite (dev/test alternative)
# DATABASE_URL=sqlite:///./koin.db

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Super Admin (seeded at startup) ──────────────────────────────────────────
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme123

# ── Email ────────────────────────────────────────────────────────────────────
# Provider: smtp | resend | gmail
MAIL_PROVIDER=smtp
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your@gmail.com
MAIL_FROM_NAME=Koin
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Resend (alternative to SMTP — works on Render/cloud without open SMTP ports)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx

# Gmail HTTP API (alternative)
# MAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=xxxx
# GMAIL_CLIENT_SECRET=xxxx
# GMAIL_REFRESH_TOKEN=xxxx

# ── Verification codes ───────────────────────────────────────────────────────
VERIFICATION_CODE_EXPIRES_IN_MINUTE=10
PASSWORD_RESET_CODE_EXPIRES_IN_MINUTE=10
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_LENGTH=6

# ── LLM ─────────────────────────────────────────────────────────────────────
# At least one provider API key is required
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TEMPERATURE=0.7
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
LLM_ALLOWED_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-pro

# Optional: override the system prompt
# CHAT_SYSTEM_PROMPT=You are Koin, a personal finance advisor...

# ── Redis (optional — enables chat memory caching) ───────────────────────────
# REDIS_URL=redis://localhost:6379/0
CHAT_MEMORY_TTL_SECONDS=86400
CHAT_CONTEXT_MESSAGE_LIMIT=20

# ── Finance ──────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
